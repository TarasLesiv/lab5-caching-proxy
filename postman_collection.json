      "name": "1. GET /200 — картинка відсутня в кеші (з http.cat)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану відповіді — 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Заголовок Content-Type — image/jpeg', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('image/jpeg');",
              "});",
              "",
              "pm.test('Картинку отримано з http.cat (X-Image-Source: http.cat)', function () {",
              "    pm.expect(pm.response.headers.get('X-Image-Source')).to.eql('http.cat');",
              "});"
            ]
